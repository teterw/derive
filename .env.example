# Neon pooled connection string (the one ending in -pooler.<region>.aws.neon.tech)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/derive?sslmode=require

# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Free key from https://www.desmos.com/api (needed from Phase 4)
NEXT_PUBLIC_DESMOS_API_KEY=

# Used once by `pnpm db:seed:admin` to create the first admin account
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
