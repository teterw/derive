{
  "name": "derive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-test.ts",
    "render-check": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/render-check.ts",
    "content:coverage": "tsx scripts/content-coverage.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:admin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-admin.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "vars": "tsx scripts/variable-survey.mjs",
    "accounts": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/accounts.ts",
    "profile-check": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/profile-check.ts",
    "perf": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/perf-check.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.110.0",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
